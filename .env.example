# Required: your Anthropic API key (used by the chat agent and the one-time crawler).
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown):
# PAULG_MODEL=claude-sonnet-4-6        # chat model; set to claude-opus-4-8 for harder questions
# PAULG_INDEX_MODEL=claude-haiku-4-5   # model used once at crawl time to summarize essays
# PAULG_SKILL_DIR=.claude/skills/pg-essays  # WARNING: also moves the agent's confinement
#                                           # boundary — point it only at the skill directory.
# PAULG_MEMORY=1                       # opt-in: enable writes so Claude Code's NATIVE cross-session
#                                      # memory works (stored under ~/.claude/projects/<proj>/memory/,
#                                      # managed by Claude Code — NOT confined by this app's guard).
#                                      # The essay corpus stays read-only either way.
